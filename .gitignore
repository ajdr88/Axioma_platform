# Node / pnpm
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# Rust
target/
Cargo.lock.bak

# Terraform (infrastructure/) — local provider plugin cache and per-run state/plan artifacts.
# .terraform.lock.hcl is NOT ignored — that's the dependency lock file, committed like Cargo.lock.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Env / secrets
.env
.env.*
!.env.example

# Claude Code local settings (machine-specific)
.claude/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker / local data volumes
.docker-data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
