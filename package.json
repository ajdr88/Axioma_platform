{
  "name": "axioma",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "docker compose up -d --wait && concurrently -n api,web -c green,magenta \"cargo run -p api\" \"pnpm --filter @axioma/web dev\"",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "concurrently": "^10.0.4",
    "turbo": "^2.10.6"
  }
}
