# Copy to .env for local development. Values below match docker-compose.yml's dev credentials —
# never use these in a non-local environment.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=axioma-dev

# Host port 5433, not 5432 — see docker-compose.yml's comment on the remap.
DATABASE_URL=postgres://axioma:axioma-dev@localhost:5433/axioma

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=axioma
S3_SECRET_KEY=axioma-dev
S3_BUCKET=axioma-geometry
